# 初期 admin（DB に admin が1人もいない状態で起動したときだけ作成される）
NUXT_INITIAL_ADMIN_EMAIL=
NUXT_INITIAL_ADMIN_PASSWORD=
NUXT_INITIAL_ADMIN_NAME=
# セッション暗号化キー（32文字以上）。開発時は未設定なら自動生成される
NUXT_SESSION_PASSWORD=
# AI 読み取りのプロバイダ（現在は gemini のみ対応。未設定時 gemini）
NUXT_LLM_PROVIDER=
# Gemini API キー（未設定だと AI 読み取りは使えず、手入力で登録する）
NUXT_GEMINI_API_KEY=
# Gemini のモデル名（未設定時 gemini-3.8-flash）
NUXT_GEMINI_MODEL=
